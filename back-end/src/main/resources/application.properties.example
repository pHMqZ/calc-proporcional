# Application Name
spring.application.name=Calculate Proporcional

# Database Configuration (Template)
# Para uso local, copie este arquivo como application.properties e preencha os valores abaixo
spring.datasource.url=${DB_URL:jdbc:h2:mem:calcpropdb}
spring.datasource.username=${DB_USER:admin}
spring.datasource.password=${DB_PASSWORD:admin}

# H2 Console
spring.h2.console.enabled=true

# JPA / Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

# Active Profile (dev, uat, prod)
spring.profiles.active=${SPRING_PROFILES_ACTIVE:dev}
