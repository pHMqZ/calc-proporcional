#!/bin/sh

echo "=================================================="
echo "    Executando Validações de Pre-commit (Husky)   "
echo "=================================================="

# Captura os arquivos que estão no stage (staged)
STAGED_FILES=$(git diff --cached --name-only)

if [ -z "$STAGED_FILES" ]; then
    echo "Nenhum arquivo em stage. Commit liberado."
    exit 0
fi

# --------------------------------------------------
# 1. Validação do Front-end (Vitest)
# --------------------------------------------------
CHANGES_FRONT=$(echo "$STAGED_FILES" | grep '^front-end/')

if [ -n "$CHANGES_FRONT" ]; then
    echo "-> Alterações detectadas no Front-end. Executando testes unitários..."
    cd front-end
    
    # Executa os testes usando o Vitest de forma não-interativa
    CI=true npm test -- --run
    FRONT_STATUS=$?
    
    cd ..
    
    if [ $FRONT_STATUS -ne 0 ]; then
        echo "❌ ERRO: Testes unitários do Front-end falharam! Corrija os testes antes de fazer o commit."
        exit 1
    fi
    echo "✅ Testes unitários do Front-end passaram com sucesso!"
else
    echo "-> Nenhuma alteração detectada no Front-end."
fi

# --------------------------------------------------
# 2. Validação do Back-end (Maven/JUnit)
# --------------------------------------------------
CHANGES_BACKEND=$(echo "$STAGED_FILES" | grep '^back-end/')

if [ -n "$CHANGES_BACKEND" ]; then
    echo "-> Alterações detectadas no Back-end. Executando testes unitários..."
    cd back-end
    
    # Determina o comando apropriado (Windows vs Unix)
    if [ -f "./mvnw.cmd" ] && [ -n "$COMSPEC" ]; then
        ./mvnw.cmd test
    else
        chmod +x ./mvnw
        ./mvnw test
    fi
    BACK_STATUS=$?
    
    cd ..
    
    if [ $BACK_STATUS -ne 0 ]; then
        echo "❌ ERRO: Testes unitários do Back-end falharam! Corrija os testes antes de fazer o commit."
        exit 1
    fi
    echo "✅ Testes unitários do Back-end passaram com sucesso!"
else
    echo "-> Nenhuma alteração detectada no Back-end."
fi

echo "=================================================="
echo "🎉 Todas as validações passaram! Commit permitido."
echo "=================================================="
exit 0